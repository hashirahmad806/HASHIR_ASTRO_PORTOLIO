---
import { PROFILE } from '../data/portfolio';
import githubSnapshot from '../data/github-snapshot.json';

const chatApiBase = import.meta.env.PUBLIC_CHAT_API_URL || 'http://127.0.0.1:8000';

function getCellColor(level: number) {
  switch (level) {
    case 1:
      return 'rgba(79, 227, 181, 0.24)';
    case 2:
      return 'rgba(79, 227, 181, 0.48)';
    case 3:
      return 'rgba(79, 227, 181, 0.74)';
    case 4:
      return '#4FE3B5';
    default:
      return '#151C19';
  }
}
---

<section
  id="github"
  data-section-spy="github"
  data-api-base={chatApiBase}
  class="py-24 sm:py-32 border-t border-[rgba(242,239,233,0.07)] bg-[#0B0F0D]/60 relative overflow-hidden"
>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-12 space-y-10">
    <div class="lens-reveal flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-4">
        <div class="inline-flex items-center gap-3">
          <span class="w-8 h-px bg-[#4FE3B5]" aria-hidden="true"></span>
          <span class="font-mono-tech text-xs uppercase tracking-[0.2em] text-[#4FE3B5]">
            Open-Source Activity & Contribution Graph
          </span>
        </div>

        <h2 class="font-display text-[clamp(2.15rem,4.5vw,3.5rem)] font-bold leading-[1.04] tracking-[-0.03em] text-[#F2EFE9]">
          Live GitHub{' '}
          <em class="font-editorial italic font-normal text-[#E8B88A]">engineering</em>{' '}
          pulse
        </h2>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button
          id="refresh-github-btn"
          type="button"
          data-magnetic
          class="btn-basalt-pill min-h-[44px]"
        >
          <span id="refresh-github-label">Sync Live GitHub API</span>
        </button>

        <a
          href={PROFILE.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          class="btn-jade-island"
        >
          <span>@{PROFILE.githubHandle}</span>
          <span class="btn-badge" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <!-- 4 Real GitHub Stats Cards -->
    <div class="lens-reveal grid grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="rounded-2xl border border-[rgba(242,239,233,0.08)] bg-[#0F1412] p-5">
        <div class="font-mono-tech text-[10px] uppercase tracking-[0.14em] text-[#85948D]">
          Public Repositories
        </div>
        <div id="gh-repo-count" class="font-display text-3xl font-bold text-[#4FE3B5] mt-2">
          {githubSnapshot.stats.totalRepos}
        </div>
      </div>

      <div class="rounded-2xl border border-[rgba(242,239,233,0.08)] bg-[#0F1412] p-5">
        <div class="font-mono-tech text-[10px] uppercase tracking-[0.14em] text-[#85948D]">
          Yearly Contributions
        </div>
        <div id="gh-contrib-count" class="font-display text-3xl font-bold text-[#F2EFE9] mt-2">
          {githubSnapshot.stats.totalContributions}
        </div>
      </div>

      <div class="rounded-2xl border border-[rgba(242,239,233,0.08)] bg-[#0F1412] p-5">
        <div class="font-mono-tech text-[10px] uppercase tracking-[0.14em] text-[#85948D]">
          Active Streak
        </div>
        <div id="gh-current-streak" class="font-display text-3xl font-bold text-[#E8B88A] mt-2">
          {githubSnapshot.stats.currentStreak}d
        </div>
      </div>

      <div class="rounded-2xl border border-[rgba(242,239,233,0.08)] bg-[#0F1412] p-5">
        <div class="font-mono-tech text-[10px] uppercase tracking-[0.14em] text-[#85948D]">
          Longest Streak
        </div>
        <div class="flex items-baseline justify-between gap-2 mt-2">
          <div id="gh-longest-streak" class="font-display text-3xl font-bold text-[#F2EFE9]">
            {githubSnapshot.stats.longestStreak}d
          </div>
          <span id="gh-sync-status" class="font-mono-tech text-[10px] text-[#85948D]">
            Verified
          </span>
        </div>
      </div>
    </div>

    <!-- 52-Week Verdigris Jade Contribution Heatmap -->
    <div class="lens-reveal bezel-outer">
      <div class="bezel-inner p-5 sm:p-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="font-display font-bold text-base text-[#F2EFE9]">
              52-Week Contribution Heatmap
            </h3>
            <p class="font-mono-tech text-[11px] text-[#85948D]">
              {githubSnapshot.stats.totalContributions} contributions across {githubSnapshot.contributionCalendar.length} days on github.com/{PROFILE.githubHandle}
            </p>
          </div>
          <div class="flex items-center gap-1.5 font-mono-tech text-[10px] text-[#85948D]">
            <span>Less</span>
            {[0, 1, 2, 3, 4].map((lvl) => (
              <span
                class="w-2.5 h-2.5 rounded-[3px] border border-[rgba(242,239,233,0.08)]"
                style={`background-color: ${getCellColor(lvl)}`}
              ></span>
            ))}
            <span>More</span>
          </div>
        </div>

        <div class="overflow-x-auto pb-2">
          <div
            id="gh-heatmap-grid"
            class="grid grid-flow-col gap-1 min-w-max"
            style="grid-template-rows: repeat(7, minmax(0, 1fr));"
          >
            {githubSnapshot.contributionCalendar.map((day) => (
              <span
                title={`${day.date} · Activity level ${day.level}`}
                class="w-2.5 h-2.5 rounded-[3px] border border-[rgba(242,239,233,0.05)] transition-transform hover:scale-125"
                style={`background-color: ${getCellColor(day.level)}`}
              ></span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Language Breakdown + Recent Push Timeline -->
    <div class="lens-reveal grid grid-cols-1 lg:grid-cols-12 gap-6">
      <div class="lg:col-span-5 bezel-outer">
        <div class="bezel-inner p-6 h-full space-y-5">
          <div class="flex items-center justify-between">
            <h3 class="font-display font-bold text-lg text-[#F2EFE9]">Language Footprint</h3>
            <span class="font-mono-tech text-[10px] uppercase tracking-[0.14em] text-[#E8B88A]">
              49 Public Repos
            </span>
          </div>

          <div class="space-y-4">
            {githubSnapshot.languages.map((lang) => (
              <div class="space-y-1.5">
                <div class="flex items-center justify-between font-mono-tech text-xs">
                  <span class="text-[#F2EFE9]">{lang.name}</span>
                  <span class="text-[#4FE3B5]">{lang.percentage}%</span>
                </div>
                <div class="h-2 rounded-full bg-[#080B0A] border border-[rgba(242,239,233,0.07)] overflow-hidden">
                  <div
                    data-lang-bar
                    data-pct={lang.percentage}
                    class="h-full rounded-full origin-left"
                    style={`width: ${lang.percentage}%; background: linear-gradient(90deg, #4FE3B5 0%, #E8B88A 100%);`}
                  ></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 bezel-outer">
        <div class="bezel-inner p-6 h-full space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-display font-bold text-lg text-[#F2EFE9]">Recent Push Events</h3>
            <span class="font-mono-tech text-[10px] uppercase tracking-[0.14em] text-[#4FE3B5]">
              Public Stream
            </span>
          </div>

          <div id="gh-activity-list" class="space-y-2.5">
            {githubSnapshot.recentActivity.slice(0, 5).map((ev) => (
              <a
                href={ev.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl border border-[rgba(242,239,233,0.08)] bg-[#080B0A] hover:border-[#4FE3B5]/40 transition-colors"
              >
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-2 h-2 rounded-full bg-[#4FE3B5] shrink-0" aria-hidden="true"></span>
                  <div class="min-w-0">
                    <div class="font-display font-semibold text-sm text-[#F2EFE9] truncate">
                      {ev.repo}
                    </div>
                    <div class="font-mono-tech text-[10px] text-[#85948D]">
                      {ev.type}
                    </div>
                  </div>
                </div>
                <span class="font-mono-tech text-[11px] text-[#E8B88A] shrink-0">
                  {ev.createdAt} ↗
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Latest Repositories Grid -->
    <div id="gh-repos-grid" class="lens-reveal grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {githubSnapshot.latestRepos.map((repo) => (
        <a
          href={repo.url}
          target="_blank"
          rel="noopener noreferrer"
          class="bezel-outer group block"
        >
          <div class="bezel-inner lens-surface p-5 h-full flex flex-col justify-between gap-4">
            <div class="lens-corners" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>

            <div class="relative z-[2] space-y-2">
              <div class="flex items-start justify-between gap-2">
                <h3 class="font-display font-bold text-base text-[#F2EFE9] group-hover:text-[#4FE3B5] transition-colors break-words min-w-0">
                  {repo.name}
                </h3>
                <span class="px-2 py-0.5 rounded bg-[#0B0F0D] border border-[rgba(242,239,233,0.1)] font-mono-tech text-[10px] text-[#E8B88A] shrink-0">
                  {repo.language}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-[#B6C2BC] leading-relaxed">
                {repo.description}
              </p>
            </div>

            <div class="relative z-[2] pt-3 border-t border-[rgba(242,239,233,0.08)] flex items-center justify-between font-mono-tech text-[11px] text-[#85948D]">
              <span>Updated {repo.pushedAt}</span>
              <span class="text-[#4FE3B5]">Inspect ↗</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
