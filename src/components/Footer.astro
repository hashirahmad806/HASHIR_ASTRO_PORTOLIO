---
import { PROFILE } from '../data/portfolio';

const year = new Date().getFullYear();
---

<footer class="border-t border-[rgba(242,239,233,0.08)] bg-[#080B0A] pt-16 pb-10">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-12 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start pb-10 border-b border-[rgba(242,239,233,0.08)]">
      <div class="md:col-span-5 space-y-3">
        <a href="#hero" class="inline-flex items-center gap-2 font-display font-bold text-2xl text-[#F2EFE9]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#4FE3B5]" aria-hidden="true"></span>
          <span>{PROFILE.name}</span>
        </a>
        <p class="text-sm text-[#B6C2BC] max-w-sm leading-relaxed">
          Full-Stack & AI Systems Engineer. Built with Astro, Tailwind CSS, GSAP optical choreography, and human-factors rigor.
        </p>
      </div>

      <div class="md:col-span-4 space-y-3">
        <div class="font-mono-tech text-[10px] uppercase tracking-[0.18em] text-[#85948D]">
          Navigate
        </div>
        <ul class="grid grid-cols-2 gap-y-2 gap-x-4 text-sm text-[#B6C2BC]" role="list">
          <li><a href="#systems" class="hover:text-[#4FE3B5] transition-colors">Systems</a></li>
          <li><a href="#capabilities" class="hover:text-[#4FE3B5] transition-colors">Capabilities</a></li>
          <li><a href="#experience" class="hover:text-[#4FE3B5] transition-colors">Experience</a></li>
          <li><a href="#credentials" class="hover:text-[#4FE3B5] transition-colors">Credentials</a></li>
          <li><a href="#github" class="hover:text-[#4FE3B5] transition-colors">GitHub</a></li>
          <li><a href="#contact" class="hover:text-[#4FE3B5] transition-colors">Contact</a></li>
        </ul>
      </div>

      <div class="md:col-span-3 space-y-3 md:text-right">
        <div class="font-mono-tech text-[10px] uppercase tracking-[0.18em] text-[#85948D]">
          Quick Actions
        </div>
        <div class="flex flex-wrap md:justify-end gap-2">
          <a
            href={PROFILE.cvUrl}
            download="Hashir_Ahmad_CV.pdf"
            class="min-h-[44px] px-4 rounded-full border border-[rgba(242,239,233,0.14)] bg-[#0F1412] font-mono-tech text-xs text-[#E8B88A] hover:border-[#E8B88A]/50 inline-flex items-center"
          >
            CV PDF ↓
          </a>
          <a
            href="#hero"
            class="min-h-[44px] px-4 rounded-full border border-[rgba(242,239,233,0.14)] bg-[#0F1412] font-mono-tech text-xs text-[#F2EFE9] hover:border-[#4FE3B5]/50 inline-flex items-center"
          >
            Top ↑
          </a>
        </div>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 font-mono-tech text-xs text-[#85948D]">
      <p>© {year} {PROFILE.name}. Engineered with Astro & GSAP.</p>
      <p>Nocturne Basalt & Verdigris Jade · WCAG AA/AAA Focus Verified</p>
    </div>
  </div>
</footer>
