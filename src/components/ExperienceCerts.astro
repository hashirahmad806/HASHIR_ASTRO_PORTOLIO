---
import { EXPERIENCES, CERTIFICATIONS } from '../data/portfolio';
---

<section id="experience" class="py-24 sm:py-32 border-t border-[rgba(242,239,233,0.07)]">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-12 space-y-24">
    <!-- Experience & Education Section -->
    <div class="space-y-12">
      <div class="lens-reveal space-y-4">
        <div class="inline-flex items-center gap-3">
          <span class="w-8 h-px bg-[#4FE3B5]" aria-hidden="true"></span>
          <span class="font-mono-tech text-xs uppercase tracking-[0.2em] text-[#4FE3B5]">
            Experience & Academic Foundation
          </span>
        </div>

        <h2 class="font-display text-[clamp(2.15rem,4.5vw,3.5rem)] font-bold leading-[1.04] tracking-[-0.03em] text-[#F2EFE9]">
          Production{' '}
          <em class="font-editorial italic font-normal text-[#E8B88A]">track record</em>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {EXPERIENCES.map((exp) => (
          <article class="lens-reveal bezel-outer flex flex-col">
            <div class="bezel-inner lens-surface flex-1 p-6 sm:p-7 flex flex-col justify-between gap-5">
              <div class="lens-corners" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </div>

              <div class="relative z-[2] space-y-3">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="px-3 py-1 rounded-full border border-[#E8B88A]/30 bg-[#E8B88A]/10 font-mono-tech text-[10px] uppercase tracking-[0.12em] text-[#E8B88A]">
                    {exp.type}
                  </span>
                  <span class="font-mono-tech text-xs text-[#4FE3B5]">
                    {exp.period}
                  </span>
                </div>

                <div>
                  <h3 class="font-display text-xl font-bold text-[#F2EFE9]">
                    {exp.role}
                  </h3>
                  <p class="font-mono-tech text-xs text-[#85948D] mt-1">
                    {exp.organization} · {exp.location}
                  </p>
                </div>

                <p class="text-sm text-[#B6C2BC] leading-relaxed">
                  {exp.summary}
                </p>

                <ul class="space-y-2 pt-2">
                  {exp.points.map((pt) => (
                    <li class="flex items-start gap-2.5 text-xs sm:text-sm text-[#B6C2BC]">
                      <span class="text-[#4FE3B5] mt-1" aria-hidden="true">●</span>
                      <span>{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {exp.proofAsset && (
                <div class="relative z-[2] pt-4 border-t border-[rgba(242,239,233,0.08)]">
                  <button
                    type="button"
                    data-open-cert-preview={exp.proofAsset.href}
                    class="btn-basalt-pill min-h-[44px] w-full justify-between px-4"
                  >
                    <span>{exp.proofAsset.label}</span>
                    <span class="font-mono-tech text-xs text-[#4FE3B5]" aria-hidden="true">Inspect ↗</span>
                  </button>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Verified Certifications Bento -->
    <div id="credentials" class="space-y-12 scroll-mt-28">
      <div class="lens-reveal flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-3">
            <span class="w-8 h-px bg-[#E8B88A]" aria-hidden="true"></span>
            <span class="font-mono-tech text-xs uppercase tracking-[0.2em] text-[#E8B88A]">
              Verified Credentials
            </span>
          </div>

          <h2 class="font-display text-[clamp(2.15rem,4.5vw,3.5rem)] font-bold leading-[1.04] tracking-[-0.03em] text-[#F2EFE9]">
            8 enterprise &{' '}
            <em class="font-editorial italic font-normal text-[#4FE3B5]">university</em>{' '}
            certifications
          </h2>
        </div>

        <div class="inline-flex items-center gap-4 px-5 py-3.5 rounded-2xl border border-[rgba(242,239,233,0.1)] bg-[#0F1412]">
          <div class="w-10 h-10 rounded-xl bg-[#4FE3B5]/12 border border-[#4FE3B5]/30 flex items-center justify-center text-[#4FE3B5]">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="6" />
              <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
            </svg>
          </div>
          <div>
            <div class="font-display font-bold text-xl text-[#F2EFE9] leading-none">
              {CERTIFICATIONS.length} Verified
            </div>
            <div class="font-mono-tech text-[10px] uppercase tracking-[0.12em] text-[#85948D] mt-1">
              PDFs & Registry Links
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {CERTIFICATIONS.map((cert) => (
          <article
            class:list={[
              'lens-reveal bezel-outer flex flex-col',
              cert.id === 'azure-ai' ? 'md:col-span-2 lg:col-span-2' : '',
            ]}
          >
            <div class="bezel-inner lens-surface flex-1 p-6 flex flex-col justify-between gap-5">
              <div class="lens-corners" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </div>

              <div class="relative z-[2] space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <span class="px-2.5 py-1 rounded-lg border border-[#4FE3B5]/30 bg-[#0B0F0D] font-mono-tech text-[10px] uppercase tracking-[0.12em] text-[#4FE3B5]">
                    {cert.badgeCode}
                  </span>
                  <span class="font-mono-tech text-[11px] text-[#85948D]">
                    {cert.date}
                  </span>
                </div>

                <div>
                  <h3 class="font-display text-lg sm:text-xl font-bold text-[#F2EFE9] leading-snug">
                    {cert.title}
                  </h3>
                  <p class="font-mono-tech text-xs text-[#E8B88A] mt-1">
                    {cert.issuer} · {cert.platform}
                  </p>
                </div>

                <p class="text-xs sm:text-sm text-[#B6C2BC] leading-relaxed">
                  {cert.summary}
                </p>
              </div>

              <div class="relative z-[2] pt-4 border-t border-[rgba(242,239,233,0.08)] flex flex-wrap items-center justify-between gap-3">
                {cert.credentialId && (
                  <div class="font-mono-tech text-[10px] text-[#85948D]">
                    ID: <span class="text-[#F2EFE9]">{cert.credentialId}</span>
                  </div>
                )}

                <div class="flex items-center gap-2 ml-auto">
                  {cert.file && (
                    <a
                      href={cert.file}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="min-h-[40px] px-3 rounded-xl border border-[rgba(242,239,233,0.12)] bg-[#0F1412] font-mono-tech text-[11px] text-[#F2EFE9] hover:border-[#E8B88A]/50 hover:text-[#E8B88A] inline-flex items-center"
                    >
                      PDF
                    </a>
                  )}
                  {cert.verifyUrl && (
                    <a
                      href={cert.verifyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="min-h-[40px] px-3.5 rounded-xl bg-[#4FE3B5]/12 border border-[#4FE3B5]/35 font-mono-tech text-[11px] text-[#4FE3B5] hover:bg-[#4FE3B5] hover:text-[#06130F] transition-colors inline-flex items-center gap-1"
                    >
                      <span>Verify</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  <!-- Wrapify Internship Certificate Lightbox Modal -->
  <div
    id="cert-preview-modal"
    role="dialog"
    aria-modal="true"
    aria-label="Wrapify Solutions Internship Certificate Preview"
    class="fixed inset-0 z-[85] hidden items-center justify-center p-4 sm:p-6 bg-[#080B0A]/90 backdrop-blur-xl"
  >
    <div id="cert-preview-backdrop" class="absolute inset-0"></div>
    <div class="relative z-10 max-w-3xl w-full bezel-outer">
      <div class="bezel-inner p-4 sm:p-6 space-y-4">
        <div class="flex items-center justify-between">
          <div>
            <div class="font-mono-tech text-[10px] uppercase tracking-[0.16em] text-[#4FE3B5]">
              VERIFIED INTERNSHIP PROOF
            </div>
            <h3 class="font-display font-bold text-lg text-[#F2EFE9]">
              Wrapify Solutions — Full Stack Development Internship
            </h3>
          </div>
          <button
            id="cert-preview-close"
            type="button"
            aria-label="Close certificate preview"
            class="w-11 h-11 rounded-full border border-[rgba(242,239,233,0.14)] bg-[#0F1412] text-[#F2EFE9] inline-flex items-center justify-center cursor-pointer"
          >
            ✕
          </button>
        </div>

        <div class="rounded-2xl overflow-hidden border border-[rgba(242,239,233,0.1)] bg-[#080B0A]">
          <img
            id="cert-preview-img"
            src="/certificates/wrapify-internship.png"
            alt="Certificate of Internship awarded to Hashir Ahmad by Wrapify Solutions for Nov 2025 to Jan 2026"
            class="w-full h-auto object-contain max-h-[70dvh]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
